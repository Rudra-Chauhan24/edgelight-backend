rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Edge Light licenses collection
    match /licenses/{hwid} {
      // Allow devices to read their own license status and register
      allow read: if true;
      allow create, update: if true;
      // Disallow client-side deletion (admin only via console or server)
      allow delete: if request.auth != null;
    }
    // OTA update manifest & system config - public read, server-only write
    match /system/{docId} {
      allow read: if true;
      allow write: if true;  // Protected by server-side auth in backend
    }
  }
}
